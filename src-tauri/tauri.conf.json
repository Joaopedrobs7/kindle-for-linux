{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kindle para Linux",
  "version": "2.0.0",
  "identifier": "com.kindlelinux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kindle para Linux",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "Office",
    "shortDescription": "Estante Kindle e leitor EPUB no Linux",
    "longDescription": "Cliente não oficial com a biblioteca Kindle Cloud e um leitor EPUB na mesma estante."
  }
}
